# Nothing broken is ever written: every construct the rule format cannot express
# is skipped, naming the reason and the original file.
exec sh -c 'handrail import hookify; echo code=$?'
stdout '^code=0$'
! stderr .
stdout '^0 imported, 22 skipped$'

stdout '^skipped +\.claude/hookify\.ambiguous\.local\.md: conditions span more than one event: "command" names PreToolUse shell and "file_path" names PreToolUse file_edit$'
stdout 'hookify\.gizmo\.local\.md: unknown event "gizmo"'
stdout 'hookify\.lookahead\.local\.md: pattern "\(\?!skip\)foo" is not an RE2 regexp'
stdout 'hookify\.no-conditions\.local\.md: rule has no conditions, which upstream never matches'
stdout 'hookify\.odd-operator\.local\.md: condition operator "fuzzy_match" is not one handrail expresses'
stdout 'hookify\.old-text\.local\.md: condition field "old_text" has no canonical equivalent'
stdout 'hookify\.prompt-matcher\.local\.md: tool_matcher "Bash" cannot apply to event "UserPromptSubmit"'
stdout 'hookify\.stop-matcher\.local\.md: tool_matcher "Bash" cannot apply to event "Stop"'
stdout 'hookify\.matcher-clash\.local\.md: tool_matcher "Bash" names shell, and the rest of the rule names file_edit'
stdout 'hookify\.stop-reason\.local\.md: condition field "reason" has no canonical equivalent'
stdout 'hookify\.task-tool\.local\.md: tool_matcher "Task" names a tool with no canonical kind'
stdout 'hookify\.transcript\.local\.md: condition field "transcript" has no canonical equivalent'
stdout 'hookify\.unnamed\.local\.md: rule has no name'

# The name is the converted file's basename, so a name that is not a basename is
# a rule handrail has nowhere to put.
stdout 'hookify\.dotted\.local\.md: name "\.hidden" is not a usable filename'
stdout 'hookify\.slashed\.local\.md: name "nested/rule" is not a usable filename'

# Upstream's own shapes for a condition list, each rejected where upstream would
# have read nothing from it either.
stdout 'hookify\.flat-conditions\.local\.md: line 4: conditions must be a list'
stdout 'hookify\.list-item\.local\.md: line 6: condition must be a mapping'
stdout 'hookify\.nested-field\.local\.md: line 5: field must be a single value'

# An all rule whose fields name a tool event and a prompt event names neither.
stdout 'hookify\.prompt-and-command\.local\.md: conditions span more than one event: "command" names PreToolUse shell and "user_prompt" names UserPromptSubmit$'

# A matcher listing tools of two kinds is two rules, not one.
stdout 'hookify\.read-or-bash\.local\.md: tool_matcher "Bash\|Read" spans more than one tool kind'

# The converted rule is parsed back before it is written, so an upstream rule
# whose body is empty is caught here rather than by the next handrail check.
stdout 'hookify\.mute\.local\.md: converted rule is invalid: line 1: rule has no message'

# Upstream's glob matches a directory as readily as a file.
stdout 'hookify\.folder\.local\.md: read .*hookify\.folder\.local\.md: is a directory'

# A skipped rule leaves nothing behind, so the tier is never even created.
! exists .handrail/local

# The originals are untouched, so a hand-port still has them.
exists .claude/hookify.transcript.local.md

-- .git/HEAD --
ref: refs/heads/main
-- .claude/hookify.old-text.local.md --
---
name: old-text
event: file
conditions:
  - field: old_text
    operator: contains
    pattern: TODO
---
Replaced text is not in the canonical payload.
-- .claude/hookify.transcript.local.md --
---
name: require-tests-run
enabled: false
event: stop
action: block
conditions:
  - field: transcript
    operator: not_contains
    pattern: npm test|pytest|cargo test
---
Run the tests before stopping.
-- .claude/hookify.stop-reason.local.md --
---
name: stop-reason
event: stop
conditions:
  - field: reason
    operator: contains
    pattern: done
---
The stop reason is not in the canonical payload.
-- .claude/hookify.lookahead.local.md --
---
name: lookahead
event: bash
pattern: (?!skip)foo
---
RE2 has no lookarounds.
-- .claude/hookify.task-tool.local.md --
---
name: task-tool
tool_matcher: Task
conditions:
  - field: command
    operator: contains
    pattern: deploy
---
No canonical kind covers the Task tool.
-- .claude/hookify.ambiguous.local.md --
---
name: ambiguous
conditions:
  - field: command
    operator: contains
    pattern: rm
  - field: file_path
    operator: contains
    pattern: .env
---
An all rule whose fields span two events.
-- .claude/hookify.no-conditions.local.md --
---
name: no-conditions
event: bash
action: block
---
Upstream never matches a rule with no conditions.
-- .claude/hookify.odd-operator.local.md --
---
name: odd-operator
event: bash
conditions:
  - field: command
    operator: fuzzy_match
    pattern: rm
---
Upstream never matches an unknown operator either.
-- .claude/hookify.unnamed.local.md --
---
event: bash
conditions:
  - field: command
    operator: contains
    pattern: rm
---
The converted filename comes from the name field.
-- .claude/hookify.gizmo.local.md --
---
name: gizmo
event: gizmo
conditions:
  - field: command
    operator: contains
    pattern: rm
---
No such upstream event.
-- .claude/hookify.stop-matcher.local.md --
---
name: stop-matcher
event: stop
tool_matcher: Bash
conditions:
  - field: content
    operator: contains
    pattern: rm
---
A Stop event carries no tool.
-- .claude/hookify.prompt-matcher.local.md --
---
name: prompt-matcher
tool_matcher: Bash
conditions:
  - field: user_prompt
    operator: contains
    pattern: deploy
---
An all rule whose inferred event carries no tool either.
-- .claude/hookify.dotted.local.md --
---
name: .hidden
event: bash
pattern: rm
---
A leading dot names a file nobody asked for.
-- .claude/hookify.slashed.local.md --
---
name: nested/rule
event: bash
pattern: rm
---
A separator names a file in a directory nobody asked for.
-- .claude/hookify.flat-conditions.local.md --
---
name: flat-conditions
event: bash
conditions: rm -rf
---
Upstream reads conditions as a list or not at all.
-- .claude/hookify.list-item.local.md --
---
name: list-item
event: bash
conditions:
  -
    - field: command
      operator: contains
      pattern: rm
---
Each condition is a field, an operator, and a pattern, not a list of them.
-- .claude/hookify.nested-field.local.md --
---
name: nested-field
event: bash
conditions:
  - field:
      name: command
    operator: contains
    pattern: rm
---
The field names one canonical field, not a mapping.
-- .claude/hookify.prompt-and-command.local.md --
---
name: prompt-and-command
conditions:
  - field: command
    operator: contains
    pattern: deploy
  - field: user_prompt
    operator: contains
    pattern: deploy
---
An all rule whose fields span a tool call and a prompt.
-- .claude/hookify.read-or-bash.local.md --
---
name: read-or-bash
tool_matcher: Bash|Read
conditions:
  - field: command
    operator: contains
    pattern: cat
---
Running a command and reading a file are two rules.
-- .claude/hookify.mute.local.md --
---
name: mute
event: bash
pattern: rm
---
-- .claude/hookify.folder.local.md/.keep --
-- .claude/hookify.matcher-clash.local.md --
---
name: matcher-clash
event: file
tool_matcher: Bash
conditions:
  - field: file_path
    operator: contains
    pattern: .env
---
The matcher and the fields select different tools.

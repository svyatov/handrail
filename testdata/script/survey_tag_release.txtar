[!exec:git] skip

# tag-release: the workflows the git index tracks, and a stat of package.json.
cd repo
exec git init -q
exec git add .github
exec handrail survey
stdout '"id": "tag-release",\n +"paths": \[\n +"package.json",\n +".github/workflows/release.yml"\n +\]'

exec handrail test PreToolUse --kind shell --field 'command=git tag -a v1.0.0 -m r'
stdout '^warn  tag-release  global$'
exec handrail test PreToolUse --kind shell --field 'command=git push --tags'
stdout '^warn  tag-release  global$'
exec handrail test PreToolUse --kind shell --field 'command=npm publish'
stdout '^warn  tag-release  global$'
exec handrail test PreToolUse --kind shell --field 'command=git tag'
stdout '^outcome: allow$'

# A tag after a quoted message, a tag pushed by name, and a push that follows
# tags all publish; a branch push and a flag of a later command do not.
exec handrail test PreToolUse --kind shell --field 'command=git tag -a -m "Release 1.0" v1.0.0'
stdout '^warn  tag-release  global$'
exec handrail test PreToolUse --kind shell --field 'command=git push origin v1.0.0'
stdout '^warn  tag-release  global$'
exec handrail test PreToolUse --kind shell --field 'command=git push origin main --follow-tags'
stdout '^warn  tag-release  global$'
exec handrail test PreToolUse --kind shell --field 'command=git push origin main'
stdout '^outcome: allow$'
exec handrail test PreToolUse --kind shell --field 'command=git tag && head -1 CHANGELOG.md'
stdout '^outcome: allow$'

-- repo/package.json --
{}
-- repo/.github/workflows/release.yml --
on:
  push:
    tags: ['v*']
-- home/.config/handrail/tag-release.md --
---
event: PreToolUse
kind: shell
conditions:
  - any:
      - field: command
        matches: git\s+push\s+([^\s;&|]+\s+)*(--tags|--follow-tags|(refs/tags/)?v?\d)
      - field: command
        matches: git\s+tag\s+([^\s;&|]+\s+)*v?\d
      - field: command
        starts_with: npm publish
---
A tag push publishes a release.

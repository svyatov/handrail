# git-hooks: a stat of each hook manager's file or directory.
cd repo
exec handrail survey
stdout '"id": "git-hooks",\n +"paths": \[\n +".husky"\n +\]'

exec handrail test PreToolUse --kind shell --field 'command=git commit -n -m wip'
stdout '^warn  git-hooks  global$'
exec handrail test PreToolUse --kind shell --field 'command=git commit --no-verify -m wip'
stdout '^warn  git-hooks  global$'
exec handrail test PreToolUse --kind shell --field 'command=git commit -m wip'
stdout '^outcome: allow$'

# A flag of a later command in the line is not the commit's.
exec handrail test PreToolUse --kind shell --field 'command=git commit -m wip && git log -n 3'
stdout '^outcome: allow$'
exec handrail test PreToolUse --kind shell --field 'command=git commit -m wip; grep -n foo a.ts'
stdout '^outcome: allow$'
stdin ../newline.json
exec handrail test PreToolUse --stdin
stdout '^outcome: allow$'

# A global option before the subcommand, and a hooks path pointed away.
exec handrail test PreToolUse --kind shell --field 'command=git -C sub commit -n -m wip'
stdout '^warn  git-hooks  global$'
exec handrail test PreToolUse --kind shell --field 'command=git -c core.hooksPath=/dev/null commit -m wip'
stdout '^warn  git-hooks  global$'

-- newline.json --
{"hook_event_name": "PreToolUse", "tool_name": "Bash", "tool_input": {"command": "git commit -m wip\ngit log -n 3"}}
-- repo/.git/HEAD --
ref: refs/heads/main
-- repo/.husky/pre-commit --
-- home/.config/handrail/git-hooks.md --
---
event: PreToolUse
kind: shell
conditions:
  - any:
      - field: command
        contains: --no-verify
      - field: command
        contains: core.hooksPath
      - field: command
        matches: git[ \t]+(-[Cc][ \t]+[^\s;&|]+[ \t]+)*commit[ \t]+([^\s;&|]+[ \t]+)*-\w*n
---
The commit hooks run on every commit.

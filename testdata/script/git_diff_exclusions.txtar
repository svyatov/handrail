# These are synthetic payloads. No named file is opened or command executed.
exec handrail test PreToolUse --kind shell --field 'command=git diff HEAD --stat -- . ":(exclude).env" ":(exclude).env.*" ":(exclude)**/.env" ":(exclude)**/.env.*"'
! stdout 'block  env-files'

# An excluded operand does not hide another read or a redirect.
! exec handrail test PreToolUse --kind shell --field 'command=git diff HEAD -- .env ":(exclude)**/.env"'
stdout 'block  env-files'
! exec handrail test PreToolUse --kind shell --field 'command=git diff HEAD -- . ":(exclude)**/.env"; cat .env'
stdout 'block  env-files'

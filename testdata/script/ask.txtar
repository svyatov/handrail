# ask hands a PreToolUse call to the human on Claude Code and warns on Codex,
# which has no hook approval path.

# ask is an Action on PreToolUse.
exec handrail check
stdout '^global +ask-push +PreToolUse +shell +ask +enabled$'

# Only a tool call can be approved, so ask on any other event is invalid.
cp ask-later.md home/.config/handrail/ask-later.md
! exec handrail check
stderr 'ask-later\.md: line 3: ask applies only to PreToolUse'
rm home/.config/handrail/ask-later.md

# Claude Code asks: the human reads the rule in the approval prompt, and the
# agent gets it as context, so a refusal still tells it why.
stdin push.json
exec handrail hook claude PreToolUse
! stderr .
stdout '"permissionDecision": "ask"'
stdout '"permissionDecisionReason": "handrail ask: ask-push \(global\)\\nPushes publish work; the human approves each one\."'
stdout '"additionalContext": "handrail ask: ask-push \(global\)\\nPushes publish work; the human approves each one\."'

# What handrail tells the human rides in the approval prompt, not beside it.
cp ask-later.md home/.config/handrail/ask-later.md
stdin push.json
exec handrail hook claude PreToolUse
stdout '"permissionDecisionReason": "handrail ask: .*skipped the broken rule .*ask-later\.md'
! stdout 'systemMessage'
rm home/.config/handrail/ask-later.md

# Codex delivers a normal warning: full context for the agent, one label for
# the human, and no permission decision to stop the call.
stdin push.json
exec handrail hook codex PreToolUse
! stderr .
! stdout 'permissionDecision'
stdout '"additionalContext": "handrail warn: ask-push \(global\)\\nPushes publish work; the human approves each one\."'
stdout '"systemMessage": "handrail warn: ask-push \(global\)"'

# sync reports that substitution, on Codex alone, with the same reason.
exec handrail sync
stdout '^codex: ask degraded to warn for ask-push: Codex CLI cannot ask for approval, so the call proceeds with a warning$'
! stdout 'claude: ask degraded'

exec handrail doctor
stdout 'codex: ask degraded to warn for ask-push: Codex CLI cannot ask for approval, so the call proceeds with a warning'

# test exits 3 on ask, and the human line is the approval prompt's text.
exec sh -c 'handrail test PreToolUse --kind shell --field "command=git push"; echo code=$?'
stdout '^ask  ask-push  global$'
stdout '^outcome: ask$'
stdout '^human:\n  handrail ask: ask-push \(global\)\n  Pushes publish work; the human approves each one\.$'
stdout '^code=3$'

# --harness codex reports the delivered warn while retaining the original ask,
# and exits 0 because the call proceeds.
exec handrail test PreToolUse --kind shell --field 'command=git push' --harness codex --json
stdout '"action": "warn"'
stdout '"degraded_from": "ask"'
stdout '"outcome": "warn"'
stdout '"human": "handrail warn: ask-push \(global\)"'

# A separate block still denies the call after each ask has degraded to warn.
cp block-push.md home/.config/handrail/block-push.md
stdin push.json
exec handrail hook codex PreToolUse
stdout '"permissionDecision": "deny"'
stdout '"systemMessage": "handrail warn: ask-push \(global\)\\nhandrail block: block-push \(global\)\\nDo not push from this session\."'
! exec handrail test PreToolUse --kind shell --field 'command=git push' --harness codex --json
stdout '"outcome": "block"'

-- push.json --
{"hook_event_name": "PreToolUse", "tool_name": "Bash", "tool_input": {"command": "git push"}}
-- .git/HEAD --
ref: refs/heads/main
-- home/.claude/settings.json --
{}
-- home/.codex/hooks.json --
{}
-- ask-later.md --
---
event: PostToolUse
action: ask
---
Too late to approve anything.
-- block-push.md --
---
event: PreToolUse
kind: shell
action: block
conditions:
  - field: command
    starts_with: git push
---
Do not push from this session.
-- home/.config/handrail/ask-push.md --
---
event: PreToolUse
kind: shell
action: ask
conditions:
  - field: command
    starts_with: git push
---
Pushes publish work; the human approves each one.

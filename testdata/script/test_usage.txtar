# Anything the synthetic payload cannot be built from is a usage error.

exec handrail trust
exec sh -c 'handrail test; echo code=$?'
stdout '^code=1$'
stderr 'handrail test: missing event'

exec sh -c 'handrail test Nope; echo code=$?'
stdout '^code=1$'
stderr 'handrail test: unknown event "Nope"'

exec sh -c 'handrail test PreToolUse --field cmd=x; echo code=$?'
stdout '^code=1$'
stderr 'unknown canonical field "cmd"'

exec sh -c 'handrail test PreToolUse --field command; echo code=$?'
stdout '^code=1$'
stderr 'expected key=value'

# A field carried empty is a field not carried, so the flags cannot build a
# payload the hook path cannot: naming one with no value is a usage error rather
# than a silent drop, because the case it looks like it is testing is the case
# it would get wrong.
exec sh -c 'handrail test PreToolUse --field command=; echo code=$?'
stdout '^code=1$'
stderr 'field "command" needs a value'

exec sh -c 'handrail test PreToolUse --kind bash; echo code=$?'
stdout '^code=1$'
stderr 'handrail test: unknown kind "bash"'

exec sh -c 'handrail test PreToolUse --harness nope; echo code=$?'
stdout '^code=1$'
stderr 'handrail test: unknown harness "nope"'

exec sh -c 'handrail test PreToolUse Stop; echo code=$?'
stdout '^code=1$'
stderr 'handrail test: unexpected argument "Stop"'

# Rules that do not parse fail the dry-run rather than being silently skipped:
# test is an authoring-time surface, so it is strict like check.
exec sh -c 'cd broken && handrail trust'
exec sh -c 'cd broken && handrail test PreToolUse; echo code=$?'
stdout '^code=1$'
stderr 'bad\.md: line 2: unknown event "Nope"'

# --stdin reads what the harness sends, through the same normalization the hook
# path uses: the kind comes from tool_name rather than being named, and the
# command comes out of tool_input. The payload's own cwd is discarded, so the
# ruleset under test is the one in the working directory, not the one the
# capture was taken under.
stdin payload.json
exec sh -c 'handrail test PreToolUse --stdin; echo code=$?'
stdout '^code=2$'
stdout '^block  danger  project-shared$'

# Codex sends the same shape, so reading a capture as either harness agrees.
stdin payload.json
exec sh -c 'handrail test PreToolUse --stdin --harness codex; echo code=$?'
stdout '^code=2$'

# Flags override the payload, so one field can be varied against a real capture.
stdin payload.json
exec sh -c 'handrail test PreToolUse --stdin --field command="rm -rf build"; echo code=$?'
stdout '^code=0$'
stdout '^outcome: allow$'

stdin not-json.txt
exec sh -c 'handrail test PreToolUse --stdin; echo code=$?'
stdout '^code=1$'
stderr 'handrail test: reading payload'

-- .git/HEAD --
ref: refs/heads/main
-- payload.json --
{
  "session_id": "abc",
  "cwd": "/repo",
  "hook_event_name": "PreToolUse",
  "tool_name": "Bash",
  "tool_input": {"command": "rm -rf /", "description": "clean"}
}
-- not-json.txt --
not json at all
-- .handrail/danger.md --
---
event: PreToolUse
kind: shell
action: block
conditions:
  - field: command
    starts_with: rm -rf /
---
Never delete recursively from the filesystem root.
-- broken/.git/HEAD --
ref: refs/heads/main
-- broken/.handrail/bad.md --
---
event: Nope
---
No such event.

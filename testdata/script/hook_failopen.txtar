# Nothing handrail gets wrong at event time may stop the harness, and nothing it
# skips may be skipped quietly.
exec handrail trust

# A broken rule alongside a blocking one still blocks, and still says so.
stdin rm.json
exec handrail hook claude PreToolUse
stdout '"permissionDecision": "deny"'
stdout '"permissionDecisionReason": "handrail block: blocker \(project-shared\)'
stdout '"systemMessage": "handrail block: blocker \(project-shared\).*skipped the broken rule'

# Empty stdin never blocks the harness: fail open, loudly, as for malformed
# JSON (unreadable_payload.txtar), since it is the same fault: nothing to parse.
exec sh -c 'printf "" | handrail hook claude PreToolUse; echo code=$?'
stdout '^code=0$'
stdout 'could not parse the PreToolUse payload'

# SessionEnd has no decision control and its JSON output is discarded, so its
# one remaining channel is stderr, which the harness shows to the user.
stdin session-end.json
exec sh -c 'handrail hook claude SessionEnd; echo code=$?'
stdout '^code=2$'
! stdout 'hookSpecificOutput'
stderr 'skipped the broken rule'

# The harness and the event are named by sync, so getting them wrong is a bug in
# handrail's own config rather than something to fail open on.
stdin bash.json
! exec handrail hook claude Nope
stderr 'unknown event "Nope"'
stdin bash.json
! exec handrail hook nosuch PreToolUse
stderr 'unknown harness "nosuch"'

-- .git/HEAD --
ref: refs/heads/main
-- bash.json --
{"hook_event_name": "PreToolUse", "tool_name": "Bash", "tool_input": {"command": "ls"}}
-- rm.json --
{"hook_event_name": "PreToolUse", "tool_name": "Bash", "tool_input": {"command": "rm -rf /"}}
-- session-end.json --
{"hook_event_name": "SessionEnd", "end_reason": "clear"}
-- .handrail/broken.md --
---
event: Nope
---
An event that does not exist is caught at authoring time, but a rule can also
break under a binary that has moved on, so the hook path has to survive it.
-- .handrail/works.md --
---
event: PreToolUse
kind: shell
---
The rule next to a broken one is still evaluated.
-- .handrail/blocker.md --
---
event: PreToolUse
kind: shell
action: block
conditions:
  - field: command
    starts_with: rm -rf
---
Not from the filesystem root.

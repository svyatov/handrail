# doctor is the first command for "why is nothing firing". Every answer it gives
# is already on this machine: it reads files and never a network.
cd repo
exec handrail trust
exec handrail sync
exec handrail doctor
! stdout 'problem'

# The binary answering, and the version it is.
stdout '^ok +handrail dev at /'

# Both harnesses are covered when both are installed, each under its own name.
stdout '^ok +claude: config at .*/home/\.claude/settings\.json$'
stdout '^ok +claude: 8 hook entries current$'
stdout '^ok +codex: config at .*/home/\.codex/hooks\.json$'
stdout '^ok +codex: 8 hook entries current$'

# Degradations and fail-open quirks are reprintable here, not only at sync time.
stdout '^note +codex: block degraded to warn for late: Codex CLI cannot fail closed on UserPromptSubmit before the model request \(upstream #33630\)$'
! stdout 'claude: block degraded'
stdout '^note +codex: SessionEnd cannot tell the human: Codex CLI shows the user no hook output there$'
stdout '^note +claude: hook errors and timeouts fail open'
stdout '^note +codex: non-managed hooks need a one-time trust review'
! stdout 'claude: non-managed hooks'

# Tier discovery for the current repo, with the directory each tier was read
# from: a wrong root is the other half of "why is nothing firing".
stdout '^ok +project root .*/repo$'
stdout '^ok +global: 1 rule in .*/home/\.config/handrail$'
stdout '^ok +project-shared: 2 rules in .*/repo/\.handrail, trusted$'
stdout '^ok +project-personal: 2 rules in .*/repo/\.handrail/local$'

# The supply check and the exclusion line sync writes.
stdout '^ok +\.handrail/local/ is not supplied by the repository$'
stdout '^ok +\.handrail/local/ is excluded in \.git/info/exclude$'

# The Decision log's grant, with where it writes and how much it holds.
stdout '^note +the Decision log is off for this project, so only trial matches are recorded: .*/home/\.local/state/handrail/log\.jsonl, not written yet$'

# The Enforcement state and where it was set.
stdout '^ok +enforcement state: enforce \(default\)$'

# The ruleset's validity with the count on trial, and every Example.
stdout '^ok +5 rules valid, 1 on trial$'
stdout '^ok +2 Examples pass$'

# A granted log that holds lines, and a state that is not enforce.
exec handrail log on
stdin rm.json
exec handrail hook claude PreToolUse
exec handrail mode trial
exec handrail doctor
! stdout 'problem'
stdout '^ok +the Decision log is on for this project: .*/log\.jsonl, [1-9][0-9]* bytes$'
stdout '^note +enforcement state: trial \(this project: .*/repo\)$'
exec handrail mode enforce

# A harness that has never run on this machine is a fact, not a fault.
mv $WORK/home/.codex $WORK/home/.codex-gone
exec handrail doctor
stdout '^note +codex: not installed$'
! stdout 'problem'
! stdout 'codex: 8 hook entries'

# Outside a git working tree there is nothing to exclude, so nothing is wrong.
cd $WORK
exec handrail doctor
! stdout 'problem'
stdout 'is not a git working tree, so nothing needs excluding'

# A Project-shared tier this machine never trusted says so, even empty.
stdout '^ok +project-shared: 0 rules in .*/\.handrail, not trusted$'

-- repo/rm.json --
{"hook_event_name": "PreToolUse", "session_id": "s1", "tool_name": "Bash", "tool_input": {"command": "rm -rf build"}}
-- repo/.handrail/local/watched.md --
---
event: PreToolUse
kind: shell
trial: true
conditions:
  - field: command
    starts_with: rm
examples:
  match:
    - command: rm -rf build
  no_match:
    - command: ls
---
Watched before it is enforced.

-- home/.claude/settings.json --
{}
-- home/.codex/hooks.json --
{}
-- home/.config/handrail/global.md --
---
event: PreToolUse
---
A rule every repo on this machine carries.
-- repo/.git/HEAD --
ref: refs/heads/main
-- repo/.handrail/late.md --
---
event: UserPromptSubmit
action: block
---
Codex cannot hold a prompt before the model request.
-- repo/.handrail/shared.md --
---
event: PreToolUse
---
A committed rule, granted by trust.
-- repo/.handrail/local/mine.md --
---
event: PreToolUse
---
The user's own rule.

# A shell call's file payloads on the hook path: one message per rule however
# many payloads it matched, and the Outcome is the strongest across them all.
exec handrail trust

# The shell payload matches a warn, a file payload a block: the call is blocked,
# and each rule speaks once.
stdin twelve.json
exec handrail hook claude PreToolUse
stdout '"permissionDecisionReason": "handrail warn: echo \(project-shared\)\\nAn echo\.\\n\\nhandrail block: env-writes \(project-shared\)\\nNever write \.env files\.\\nMatched files:\\n  a\.env\\n  b\.env\\n  c\.env\\n  d\.env\\n  e\.env\\n  f\.env\\n  g\.env\\n  h\.env\\n  i\.env\\n  j\.env\\n  and 2 more"$'

# One matched file is named by the rule's message alone.
stdin one.json
exec handrail hook claude PreToolUse
stdout '"permissionDecision": "deny"'
! stdout 'Matched files'

# Two spellings of one file are one file, so there is nothing to list.
stdin two-spellings.json
exec handrail hook claude PreToolUse
stdout 'handrail warn: env-reads'
! stdout 'Matched files'

-- .git/HEAD --
ref: refs/heads/main
-- twelve.json --
{
  "hook_event_name": "PreToolUse",
  "tool_name": "Bash",
  "tool_input": {"command": "echo x >a.env >b.env >c.env >d.env >e.env >f.env >g.env >h.env >i.env >j.env >k.env >l.env"}
}
-- two-spellings.json --
{
  "hook_event_name": "PreToolUse",
  "tool_name": "Bash",
  "tool_input": {"command": "cat src/../.env ./.env"}
}
-- .handrail/env-reads.md --
---
event: PreToolUse
kind: file_read
conditions:
  - field: path
    glob: "*.env"
---
Reads a .env file.
-- one.json --
{
  "hook_event_name": "PreToolUse",
  "tool_name": "Bash",
  "tool_input": {"command": "echo x > a.env"}
}
-- .handrail/echo.md --
---
event: PreToolUse
kind: shell
conditions:
  - field: command
    starts_with: echo
---
An echo.
-- .handrail/env-writes.md --
---
event: PreToolUse
kind: file_edit
action: block
conditions:
  - field: path
    glob: '*.env'
---
Never write .env files.

# A shell call's file payloads on the hook path: one message per rule however
# many payloads it matched, and the Outcome is the strongest across them all.
exec handrail trust

# The shell payload matches a warn, a file payload a block: the call is blocked,
# and each rule speaks once.
stdin twelve.json
exec sh -c 'handrail hook claude PreToolUse; echo code=$?'
stdout '^code=2$'
cmp stderr expected-twelve

# One matched file is named by the rule's message alone.
stdin one.json
exec sh -c 'handrail hook claude PreToolUse; echo code=$?'
stdout '^code=2$'
! stderr 'Matched files'

-- .git/HEAD --
ref: refs/heads/main
-- twelve.json --
{
  "hook_event_name": "PreToolUse",
  "tool_name": "Bash",
  "tool_input": {"command": "echo x >a.env >b.env >c.env >d.env >e.env >f.env >g.env >h.env >i.env >j.env >k.env >l.env"}
}
-- one.json --
{
  "hook_event_name": "PreToolUse",
  "tool_name": "Bash",
  "tool_input": {"command": "echo x > a.env"}
}
-- .handrail/echo.md --
---
event: PreToolUse
kind: shell
conditions:
  - field: command
    starts_with: echo
---
An echo.
-- .handrail/env-writes.md --
---
event: PreToolUse
kind: file_edit
action: block
conditions:
  - field: path
    glob: '*.env'
---
Never write .env files.
-- expected-twelve --
handrail warn: echo (project-shared)
An echo.

handrail block: env-writes (project-shared)
Never write .env files.
Matched files:
  a.env
  b.env
  c.env
  d.env
  e.env
  f.env
  g.env
  h.env
  i.env
  j.env
  and 2 more

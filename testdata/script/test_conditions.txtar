# Conditions AND implicitly; a one-level any group is the only OR.

# Both halves present: the AND rule fires.
exec handrail trust
exec sh -c 'handrail test PreToolUse --field command="git push --force origin"; echo code=$?'
stdout '^code=0$'
stdout '^warn  and  project-shared$'

# Either half alone is not enough.
exec sh -c 'handrail test PreToolUse --field command="git status"; echo code=$?'
! stdout '^warn  and'
exec sh -c 'handrail test PreToolUse --field command="hg push --force"; echo code=$?'
! stdout '^warn  and'

# One branch of the any group is enough, and neither is not.
exec sh -c 'handrail test PreToolUse --field path=.env; echo code=$?'
stdout '^warn  either  project-shared$'
exec sh -c 'handrail test PreToolUse --field path=id_rsa; echo code=$?'
stdout '^warn  either  project-shared$'
exec sh -c 'handrail test PreToolUse --field path=README.md; echo code=$?'
stdout '^outcome: allow$'

# An any group ANDs with its siblings like any other condition.
exec sh -c 'handrail test PreToolUse --field path=secrets/.env; echo code=$?'
stdout '^warn  either-and  project-shared$'
exec sh -c 'handrail test PreToolUse --field path=docs/.env; echo code=$?'
! stdout 'either-and'

# A bare "-" with the condition's keys indented below it is the same condition
# as the "- key: value" form.
exec sh -c 'handrail test PreToolUse --field command="chmod 777 /"; echo code=$?'
stdout '^warn  bare-item  project-shared$'

# In a single-quoted value, '' is one quote, so a pattern can carry one.
exec sh -c 'handrail test PreToolUse --field command="it''s fine"; echo code=$?'
stdout '^warn  quoted  project-shared$'

-- .git/HEAD --
ref: refs/heads/main
-- .handrail/and.md --
---
event: PreToolUse
conditions:
  - field: command
    starts_with: git
  - field: command
    contains: --force
---
Every condition in the list must hold.
-- .handrail/either.md --
---
event: PreToolUse
conditions:
  - any:
      - field: path
        ends_with: .env
      - field: path
        equals: id_rsa
---
One branch of the group is enough.
-- .handrail/either-and.md --
---
event: PreToolUse
conditions:
  - field: path
    starts_with: secrets/
  - any:
      - field: path
        ends_with: .env
      - field: path
        ends_with: .pem
---
A group is one entry of the AND list.
-- .handrail/bare-item.md --
---
event: PreToolUse
conditions:
  -
    field: command
    contains: chmod 777
---
The item's keys sit under the dash rather than beside it.
-- .handrail/quoted.md --
---
event: PreToolUse
conditions:
  - field: command
    contains: 'it''s'
---
A doubled single quote is one quote.

[!exec:git] skip

# pinned-actions: the probes of ci-workflows. Whether every action is pinned is
# the Surveyor's read of the workflows survey lists.
cd repo
exec git init -q
exec git add .github
exec handrail survey
stdout '"id": "pinned-actions",\n +"paths": \[\n +".github/workflows/ci.yml"\n +\]'

exec handrail test PreToolUse --kind file_edit --field path=.github/workflows/ci.yml --field 'content=uses: actions/checkout@v5'
stdout '^warn  pinned-actions  global$'
exec handrail test PreToolUse --kind file_edit --field path=$WORK/repo/.github/workflows/ci.yml --field 'content=uses: actions/checkout@main'
stdout '^warn  pinned-actions  global$'
exec handrail test PreToolUse --kind file_edit --field path=.github/workflows/ci.yml --field 'content=uses: actions/checkout@08c6903cd8c0fde910a37f88322edcfb5dd907a8'
stdout '^outcome: allow$'
exec handrail test PreToolUse --kind file_edit --field path=$WORK/repo/.github/workflows/ci.yml --field 'content=uses: actions/checkout@08c6903cd8c0fde910a37f88322edcfb5dd907a8'
stdout '^outcome: allow$'

-- repo/.github/workflows/ci.yml --
jobs:
  test:
    steps:
      - uses: actions/checkout@08c6903cd8c0fde910a37f88322edcfb5dd907a8
-- home/.config/handrail/pinned-actions.md --
---
event: PreToolUse
kind: file_edit
conditions:
  - field: path
    glob: '**/.github/workflows/*.y*ml'
  - field: content
    matches: uses:\s+[^\s@]+/[^\s@]+@([0-9a-f]{0,39}[^0-9a-f\s]|[0-9a-f]{1,39}(\s|$))
---
Pin every action to a full commit SHA.

# Everything sync can refuse, it refuses before touching a single config file.
exec handrail trust

# An invalid rule is reported and the hooks are still written, since they
# depend on no rule: one bad file must not leave the machine with no hooks.
exec sh -c 'handrail sync; echo code=$?'
stdout '^code=1$'
stderr 'oops\.md: line 2: unknown event "Nope"'
stdout 'claude: wrote 8 hook entries'
grep 'hook claude PreToolUse' home/.claude/settings.json
grep '^\.handrail/local/$' .git/info/exclude

# With the rules fixed, sync succeeds.
rm .handrail/oops.md
exec handrail sync
stdout 'claude: 8 hook entries already current'

# A harness handrail cannot write for is named, not guessed at.
exec sh -c 'handrail sync --harness gemini; echo code=$?'
stdout '^code=1$'
stderr 'unknown harness "gemini"'

# A harness that is not installed is not synced, and the run says so rather
# than reporting success over an empty machine.
exec sh -c 'cd nohome && HOME=$WORK/nohome XDG_CONFIG_HOME=$WORK/nohome/.config handrail sync; echo code=$?'
stdout '^code=1$'
stderr 'no harness found'

# One harness's unreadable config is that harness's failure, named, and not the
# other's: a machine with two harnesses does not lose the working one.
mkdir home/.codex
cp broken.json home/.codex/hooks.json
rm home/.claude/settings.json
exec sh -c 'handrail sync; echo code=$?'
stdout '^code=1$'
stderr 'handrail: codex: .*hooks.json'
stdout 'claude: wrote 8 hook entries'
exists home/.claude/settings.json

# A config file that is not a file is reported like any other unreadable one.
rm home/.claude/settings.json
mkdir home/.claude/settings.json
exec sh -c 'handrail sync --harness claude; echo code=$?'
stdout '^code=1$'
stderr 'handrail: claude: read .*settings.json'

# Root can write anything, so a permission case only means something as
# somebody else.
[root] stop 'this case turns on a permission denial'
rm home/.claude/settings.json
chmod 0500 home/.claude
exec sh -c 'handrail sync --harness claude; echo code=$?'
stdout '^code=1$'
stderr 'handrail: claude: .*permission denied'

-- .git/HEAD --
ref: refs/heads/main
-- broken.json --
{ not json
-- home/.claude/.keep --
-- .handrail/fine.md --
---
event: Stop
---
A rule that parses.
-- .handrail/oops.md --
---
event: Nope
---
A rule that does not.
-- nohome/.git/HEAD --
ref: refs/heads/main
